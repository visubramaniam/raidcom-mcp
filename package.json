{
  "name": "raidcom-mcp",
  "version": "0.1.7",
  "mcpName": "io.github.visubramaniam/raidcom-mcp",
  "description": "MCP server that builds and checks Hitachi raidcom commands from structured requests. Build-only: it never connects to a storage system. Not an official Hitachi Vantara product.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "raidcom-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "spec",
    "INSTALL.md",
    "CHANGELOG.md",
    "PRIVACY.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "eval": "npm run build && node tests/search-eval.mjs",
    "generate-catalog": "node scripts/generate-catalog.mjs",
    "test": "npm run build && node --test \"tests/unit/*.test.mjs\" && node tests/search-eval.mjs",
    "prepublishOnly": "npm test",
    "package": "npm run build && node scripts/package.mjs",
    "smoke": "node tests/smoke/package-smoke.mjs release/raidcom-mcp-$npm_package_version.tgz $npm_package_version"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  },
  "author": "Vinod Subramaniam",
  "homepage": "https://github.com/visubramaniam/raidcom-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/visubramaniam/raidcom-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/visubramaniam/raidcom-mcp/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "hitachi",
    "raidcom",
    "cci",
    "storage"
  ]
}
