{
  "name": "raidcom-community",
  "displayName": "Hitachi raidcom command builder (Community)",
  "version": "0.1.2",
  "description": "Community MCP server that builds and validates Hitachi raidcom commands and scripts from plain-language requests. Build-only: it never connects to a storage system. Not an official Hitachi Vantara product.",
  "author": {
    "name": "Vinod Subramaniam",
    "url": "https://github.com/visubramaniam"
  },
  "homepage": "https://github.com/visubramaniam/raidcom-mcp",
  "repository": "https://github.com/visubramaniam/raidcom-mcp",
  "license": "MIT",
  "keywords": [
    "hitachi",
    "raidcom",
    "cci",
    "storage",
    "vsp",
    "provisioning"
  ],
  "documentationUrl": "https://github.com/visubramaniam/raidcom-mcp/blob/main/README.plugin.md",
  "privacyPolicyUrl": "https://github.com/visubramaniam/raidcom-mcp/blob/main/README.plugin.md#privacy",
  "supportUrl": "https://github.com/visubramaniam/raidcom-mcp/issues",
  "mcpServers": {
    "raidcom": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/node_modules/raidcom-mcp/dist/index.js"
      ]
    }
  }
}
